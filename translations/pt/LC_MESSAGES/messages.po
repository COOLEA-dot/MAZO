msgstr "3. Com quem compartilhamos seus dados"

#: templates/privacy.html:47
msgid "No vendemos tu información personal. Compartimos datos solo con:"
msgstr "Não vendemos suas informações pessoais. Compartilhamos dados apenas com:"

